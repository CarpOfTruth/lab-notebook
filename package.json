{
  "name": "lab-notebook",
  "version": "1.0.0",
  "description": "**A local lab notebook for ferroelectric oxide thin film growth and characterization.**",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "setup":           "node scripts/setup.js",
